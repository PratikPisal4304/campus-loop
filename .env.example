# Copy to .env.local and fill in. Never commit .env.local.

NODE_ENV=development
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Must point at a replica set (see docker-compose.dev.yml) — transactions need one.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=campus_loop

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Media (Cloudinary) -----------------------------------------------------
# Listing photos upload straight from the browser with a server-signed request,
# so the API secret never leaves the server and image bytes never touch it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=campus-loop

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seeding (npm run db:seed) ----------------------------------------------
# The demo accounts all share this password so the seeded data is usable in a demo.
SEED_PASSWORD=campus1234
