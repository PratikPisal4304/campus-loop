# Copy to .env.local and fill in. Never commit .env.local.

NODE_ENV=development
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Local Postgres from docker-compose.dev.yml. In production this is the Neon
# connection string, injected by the Vercel integration.
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_loop
# Direct Neon URL in production; use the local URL for Docker.
DATABASE_URL_UNPOOLED=postgresql://campus:campus@localhost:5432/campus_loop

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Media (Cloudinary) -----------------------------------------------------
# Listing photos upload straight from the browser with a server-signed request,
# so the API secret never leaves the server and image bytes never touch it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=campus-loop

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seeding (npm run db:seed) ----------------------------------------------
# The demo accounts all share this password so the seeded data is usable in a demo.
SEED_PASSWORD=campus1234

# --- Transactional email (Resend) -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Campus Loop <campus-loop@hanind.in>"
# Set to resend only when real delivery is intended. Tests use disabled.
EMAIL_DELIVERY=disabled
